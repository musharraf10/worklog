# Server Port
PORT=5000

# MongoDB Connection String
MONGO_URI=mongodb://localhost:27017/worklog

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Google OAuth (Authentication)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Google Sheets Synchronization (Tracking copy)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SHEETS_SHEET_NAME=Work Logs
GOOGLE_SHEETS_MENTOR_SHEET_NAME=Mentor Logs

# Impact & Achievements - Google Sheets Tabs (Defaults provided)
GOOGLE_SHEETS_EVENTS_SHEET_NAME=Events & Initiatives
GOOGLE_SHEETS_STUDENTS_SHEET_NAME=Student Impact

# Evidence Storage: Google Drive
# Evidence files are uploaded to Google Drive and linked directly via shared folder or file URLs.
# No paid cloud storage or local file uploads are used.
# Make sure Google Drive links have appropriate viewer permissions for appraisal review.

# Optional AI Provider (Standard Reports work 100% offline without AI)
# Note: Consumer ChatGPT subscriptions do not provide API access; a developer API key is required.
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
